# Neon connection string (Settings -> Connection string no console do Neon)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Gerada automaticamente pela Vercel quando você habilita um Blob Store no
# projeto (Storage -> Create Blob Store -> Connect to Project). Usada pra
# upload de imagem (logo, carrossel, banner de Serviços, item do cardápio,
# cupom) no portal — sem essa chave, POST /api/hotels/:hotelId/uploads
# quebra com 500 (diferente de outras integrações, upload não degrada
# graciosamente sem a chave).
BLOB_READ_WRITE_TOKEN=""

# String aleatória longa (ex: openssl rand -base64 48) usada pra assinar os JWTs de staff
JWT_SECRET=""

# String aleatória longa e SEPARADA da JWT_SECRET acima — assina os JWTs do
# portal administrativo interno do Konekto (konekto_admin), a credencial de
# maior privilégio do sistema (leitura cross-tenant de todos os hotéis).
# Secret separado é uma camada a mais de isolamento em relação ao token de
# staff/hóspede.
PLATFORM_ADMIN_JWT_SECRET=""

# E-mail/senha inicial da primeira conta do time Konekto no portal admin
# interno — sem essas duas env vars, `prisma/seed.ts` pula a criação (sem
# endpoint de auto-cadastro; só um punhado de pessoas do time usa isso).
PLATFORM_ADMIN_EMAIL=""
PLATFORM_ADMIN_INITIAL_PASSWORD=""

# Opcional: origens permitidas por CORS, separadas por vírgula. Se vazio, permite qualquer origem (*)
ALLOWED_ORIGINS=

# Chave de API do Resend (resend.com/api-keys) — usada pra mandar e-mails
# promocionais de "Clientes" no portal
RESEND_API_KEY=""

# Opcional: endereço "from" dos e-mails. Sem domínio próprio verificado no
# Resend, use o padrão de sandbox (só entrega pro e-mail dono da conta):
# RESEND_FROM_ADDRESS="Konekto <onboarding@resend.dev>"
RESEND_FROM_ADDRESS=

# Chave de API da Anthropic (console.anthropic.com) — usada pra traduzir
# automaticamente nome/descrição/etc. de serviços e itens do cardápio pra
# inglês e espanhol quando o gerente cadastra/edita em português. Sem essa
# chave, a tradução automática fica desligada e o hóspede vê o texto em
# português como fallback nos outros idiomas — o resto do sistema funciona
# normalmente.
ANTHROPIC_API_KEY=""

# Chave secreta da API do Pagar.me (dashboard.pagar.me, ambiente de teste:
# prefixo sk_test_; produção: prefixo sk_). Usada pra pagamento online da
# conta da estadia (marketplace/split) — sem essa chave, o recurso fica
# desligado e o hóspede vê "pagamento online ainda não disponível".
PAGARME_API_KEY=""

# Recipient ID do Konekto no Pagar.me (a conta mestra da plataforma, que
# recebe a taxa de cada pagamento) — obtido no dashboard do Pagar.me depois
# de completar o próprio cadastro de recebedor do Konekto.
PAGARME_MASTER_RECIPIENT_ID=""

# Percentual (0-100) retido pelo Konekto em cada pagamento de conta de
# estadia; o restante vai pro recebedor do hotel. Default 5 se não setado.
PAGARME_PLATFORM_FEE_PERCENT="5"

# Segredo compartilhado pra validar que uma chamada em /api/webhooks/pagarme
# realmente veio do Pagar.me. Configure a URL do webhook no dashboard deles
# como https://<esse-segredo>@seu-dominio/api/webhooks/pagarme (Basic Auth
# embutido na URL, usuário = segredo, senha em branco) — confirme no
# dashboard do Pagar.me se esse é o mecanismo de autenticação de webhook
# oferecido antes de configurar em produção.
PAGARME_WEBHOOK_SECRET=""
